{
  "name": "saturn",
  "version": "1.0.2",
  "description": "Saturn Client - Minecraft-Launcher mit Client-Mod, Instanzen und Logs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "gg.saturn.launcher",
    "productName": "Saturn Client",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "Saturn-Client-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Saturn Client",
      "uninstallDisplayName": "Saturn Client",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Wer-sonst13",
        "repo": "saturn"
      }
    ],
    "extraResources": [
      {
        "from": "resources/saturn-*.jar",
        "to": "."
      }
    ],
    "files": [
      "**/*",
      "!node_modules/**",
      "!dist/**",
      "!mod/**",
      "!.git/**",
      "!*.zip"
    ]
  },
  "author": "Saturn"
}
